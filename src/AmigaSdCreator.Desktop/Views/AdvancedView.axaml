<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AmigaSdCreator.Ui.ViewModels"
             xmlns:prof="using:AmigaSdCreator.Core.Profiles"
             xmlns:sys="using:System"
             x:Class="AmigaSdCreator.Desktop.Views.AdvancedView"
             x:DataType="vm:AdvancedViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Advanced" Classes="H1"/>
            <TextBlock Classes="Subtle" Margin="0,0,0,16"
                       Text="Hardware profile reference and raw partition details. Partition sizes, filesystems, MaxTransfer and Kickstart compatibility are edited in the Configure step of Prepare SD Card."/>

            <Border Classes="Card">
                <StackPanel>
                    <TextBlock Text="Hardware profiles" Classes="H2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox ItemsSource="{Binding Hardware.Profiles}" SelectedItem="{Binding Hardware.SelectedProfile}"
                                  DisplayMemberBinding="{Binding Name, x:DataType=prof:HardwareProfile}" Width="240" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Hardware.Interfaces}" SelectedItem="{Binding Hardware.SelectedInterface}"
                                  DisplayMemberBinding="{Binding Name, x:DataType=prof:StorageInterfaceProfile}" Width="380"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Hardware.SelectedProfile.Summary}" Margin="0,0,0,8"/>
                    <TextBlock Margin="0,0,0,8">
                        <Run Text="Layouts: " Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Run Text="{Binding Hardware.SelectedInterface.Layouts[0], Mode=OneWay, FallbackValue=''}"/>
                        <Run Text="  •  Bootable: " Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Run Text="{Binding Hardware.SelectedInterface.Bootable, Mode=OneWay}"/>
                        <Run Text="  •  Default MaxTransfer: " Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Run Text="{Binding Hardware.SelectedInterface.Defaults.MaxTransfer, Mode=OneWay, TargetNullValue='n/a'}"/>
                    </TextBlock>

                    <TextBlock Text="Documented facts" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactRow">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Text, StringFormat='• {0}'}"/>
                                    <Button Classes="Link" Margin="12,0,0,0" FontSize="11" HorizontalAlignment="Left"
                                            Command="{Binding $parent[UserControl].((vm:AdvancedViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding SourceUrl}"
                                            ToolTip.Tip="{Binding SourceUrl}">
                                        <TextBlock Text="{Binding SourceTitle}" FontSize="11"/>
                                    </Button>
                                    <TextBlock Margin="12,0,0,0" FontSize="11" Text="{Binding SourceNote}" Foreground="{DynamicResource WarnBrush}" IsVisible="{Binding SourceNote, Converter={StaticResource VisibleWhen}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Unverified - needs confirmation" FontWeight="SemiBold" Margin="0,8,0,4"
                               IsVisible="{Binding Hardware.SelectedInterface.Unverified, Converter={StaticResource VisibleWhen}, FallbackValue=False}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.SelectedInterface.Unverified}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String"><TextBlock Text="{Binding StringFormat='• {0}'}" Classes="Subtle"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Compatibility modes" FontWeight="SemiBold" Margin="0,10,0,4" IsVisible="{Binding Hardware.HasModes}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.Modes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="prof:CompatibilityMode">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="Subtle" FontSize="12">
                                        <Run Text="Max partition end: "/><Run Text="{Binding MaxPartitionEndBytes, Mode=OneWay, Converter={StaticResource Bytes}, TargetNullValue='no limit'}"/>
                                        <Run Text="  •  Max FFS partition: "/><Run Text="{Binding MaxFfsPartitionBytes, Mode=OneWay, Converter={StaticResource Bytes}, TargetNullValue='no limit'}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String"><TextBlock Text="{Binding StringFormat='• {0}'}" Classes="Subtle" FontSize="12"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Left" Content="Open profile folder" Command="{Binding OpenProfileFolderCommand}" VerticalAlignment="Center"/>
                        <TextBlock Classes="Subtle" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding ProfileFolder, StringFormat='Custom or corrected profiles (*.json) placed in {0} are loaded at start-up and replace built-in profiles with the same id.'}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel>
                    <TextBlock Text="RDB and partition inspector" Classes="H2"/>
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel>
                            <RadioButton Content="Card" GroupName="AdvSource" IsChecked="{Binding !UseImageFile}" Foreground="{DynamicResource TextBrush}"/>
                            <ComboBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <RadioButton Content="Image file" GroupName="AdvSource" IsChecked="{Binding UseImageFile}" Foreground="{DynamicResource TextBrush}"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseImageCommand}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding ImagePath}" IsReadOnly="True"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                    <Button Content="Inspect (read-only)" Command="{Binding InspectCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding Error, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding RawReport, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="0,10,0,0"
                             TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="420"
                             IsVisible="{Binding RawReport, Converter={StaticResource VisibleWhen}}" VerticalContentAlignment="Top"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
