<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux desktop app (Avalonia). Shares its view models with the Windows WPF app via AmigaSdCreator.Ui. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AssemblyName>amiga-sd-creator</AssemblyName>
    <RootNamespace>AmigaSdCreator.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\AmigaSdCreator.App\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AmigaSdCreator.Core\AmigaSdCreator.Core.csproj" />
    <ProjectReference Include="..\AmigaSdCreator.Linux\AmigaSdCreator.Linux.csproj" />
    <ProjectReference Include="..\AmigaSdCreator.Ui\AmigaSdCreator.Ui.csproj" />
  </ItemGroup>
</Project>
