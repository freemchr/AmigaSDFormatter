<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AmigaSdCreator.Ui.ViewModels"
             xmlns:v="using:AmigaSdCreator.Desktop.Views"
             xmlns:c="using:AmigaSdCreator.Desktop.Converters"
             x:Class="AmigaSdCreator.Desktop.App"
             RequestedThemeVariant="Dark"
             Name="Amiga SD Creator">
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://amiga-sd-creator/Themes/Controls.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://amiga-sd-creator/Themes/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <c:VisibleWhenConverter x:Key="VisibleWhen"/>
            <c:StepVisibilityConverter x:Key="StepVisible"/>
            <c:BytesConverter x:Key="Bytes"/>
            <c:StatusBrushConverter x:Key="StatusBrush"/>
            <c:SeverityGlyphConverter x:Key="Glyph"/>
            <c:VerdictTextConverter x:Key="VerdictText"/>
            <c:InverseBoolConverter x:Key="Not"/>
            <c:UseTextConverter x:Key="UseText"/>
            <c:HasItemsConverter x:Key="HasItems"/>
            <c:StatusTextConverter x:Key="StatusText"/>

            <!-- A disk in a device list: name, details and protection badge. -->
            <DataTemplate x:Key="DeviceTemplate" x:DataType="vm:DeviceItem">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="30" Height="34" CornerRadius="3" Background="{DynamicResource BlueBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="16" Height="10" Background="White" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Detail}" Classes="Subtle" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                            IsVisible="{Binding ProtectionReason, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding ProtectionReason, StringFormat='Protected: {0}'}" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:PrepareViewModel"><v:PrepareView/></DataTemplate>
        <DataTemplate DataType="vm:DiagnoseViewModel"><v:DiagnoseView/></DataTemplate>
        <DataTemplate DataType="vm:BackupRestoreViewModel"><v:BackupRestoreView/></DataTemplate>
        <DataTemplate DataType="vm:FilesViewModel"><v:FilesView/></DataTemplate>
        <DataTemplate DataType="vm:AdvancedViewModel"><v:AdvancedView/></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView/></DataTemplate>
    </Application.DataTemplates>
</Application>
