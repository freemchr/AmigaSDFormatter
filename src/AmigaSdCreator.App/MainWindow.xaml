<Window x:Class="AmigaSdCreator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amiga SD Card Creator" Width="880" SizeToContent="Height" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="Assets/app.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnose" AutomationProperties.Name="Diagnose" ToolTip="Diagnose a card (read-only)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}"/><TextBlock Text="Diagnose" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding NavigateCommand}" CommandParameter="Files" AutomationProperties.Name="Files" ToolTip="Copy files to and from Amiga partitions">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/><TextBlock Text="Files" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding NavigateCommand}" CommandParameter="Backup" AutomationProperties.Name="Backup" ToolTip="Back up or restore a whole card">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/><TextBlock Text="Backup" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding NavigateCommand}" CommandParameter="Advanced" AutomationProperties.Name="Advanced" ToolTip="Hardware profiles and raw partition details">
                        <TextBlock Text="&#xE9F5;" Style="{StaticResource Icon}"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings" ToolTip="Settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/>
                    </Button>
                </StackPanel>

                <Button DockPanel.Dock="Left" Style="{StaticResource HeaderButton}" Command="{Binding NavigateCommand}" CommandParameter="Home" AutomationProperties.Name="Back"
                        Visibility="{Binding IsHome, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" Margin="-8,0,8,0" ToolTip="Back">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="16"/>
                </Button>
                <Image Source="{DynamicResource LogoImage}" Height="72" Stretch="Uniform" Margin="0,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Amiga SD Creator - prepare Amiga-compatible storage from Windows"
                       AutomationProperties.Name="Amiga SD Creator"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!-- Shown only when not elevated -->
            <Border Background="{DynamicResource PanelAltBrush}" Padding="20,6" Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding RestartElevatedText}" Command="{Binding RestartElevatedCommand}" Padding="10,3" Margin="0" FontSize="12"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"
                               Text="{Binding ElevationNote}"/>
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
