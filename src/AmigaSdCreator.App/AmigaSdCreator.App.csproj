<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- CommunityToolkit.Mvvm 8.4 generates [ObservableProperty] partial properties only with LangVersion preview. -->
    <LangVersion>preview</LangVersion>
    <AssemblyName>AmigaSdCreator</AssemblyName>
    <RootNamespace>AmigaSdCreator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AmigaSdCreator.Core\AmigaSdCreator.Core.csproj" />
    <ProjectReference Include="..\AmigaSdCreator.Windows\AmigaSdCreator.Windows.csproj" />
    <ProjectReference Include="..\AmigaSdCreator.Ui\AmigaSdCreator.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    
  </ItemGroup>
</Project>
