<Application x:Class="AmigaSdCreator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmigaSdCreator.App.ViewModels"
             xmlns:v="clr-namespace:AmigaSdCreator.App.Views"
             xmlns:c="clr-namespace:AmigaSdCreator.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <c:VisibleWhenConverter x:Key="VisibleWhen"/>
            <c:StepVisibilityConverter x:Key="StepVisible"/>
            <c:BytesConverter x:Key="Bytes"/>
            <c:StatusBrushConverter x:Key="StatusBrush"/>
            <c:SeverityGlyphConverter x:Key="Glyph"/>
            <c:VerdictTextConverter x:Key="VerdictText"/>
            <c:InverseBoolConverter x:Key="Not"/>
            <c:UseTextConverter x:Key="UseText"/>
            <c:HasItemsConverter x:Key="HasItems"/>
            <c:StatusTextConverter x:Key="StatusText"/>

            <!-- A disk in a device list: name, details and protection badge. -->
            <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type vm:DeviceItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="34" CornerRadius="3" Background="{DynamicResource BlueBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="16" Height="10" Background="White" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                            Visibility="{Binding ProtectionReason, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding ProtectionReason, StringFormat=Protected: {0}}" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PrepareViewModel}"><v:PrepareView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnoseViewModel}"><v:DiagnoseView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}"><v:BackupRestoreView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FilesViewModel}"><v:FilesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdvancedViewModel}"><v:AdvancedView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
