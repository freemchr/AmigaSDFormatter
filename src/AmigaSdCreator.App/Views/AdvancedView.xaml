<UserControl x:Class="AmigaSdCreator.App.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Advanced" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,16"
                       Text="Hardware profile reference and raw partition details. Partition sizes, filesystems, MaxTransfer and Kickstart compatibility are edited in the Configure step of Prepare SD Card."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Hardware profiles" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox ItemsSource="{Binding Hardware.Profiles}" SelectedItem="{Binding Hardware.SelectedProfile}" DisplayMemberPath="Name" Width="240" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Hardware.Interfaces}" SelectedItem="{Binding Hardware.SelectedInterface}" DisplayMemberPath="Name" Width="380"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Hardware.SelectedProfile.Summary}" Margin="0,0,0,8"/>
                    <TextBlock Margin="0,0,0,8">
                        <Run Text="Layouts:" Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Run Text="{Binding Hardware.SelectedInterface.Layouts[0], Mode=OneWay}"/>
                        <Run Text="  &#x2022;  Bootable:" Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Run Text="{Binding Hardware.SelectedInterface.Bootable, Mode=OneWay}"/>
                        <Run Text="  &#x2022;  Default MaxTransfer:" Foreground="{DynamicResource SubtleTextBrush}"/>
                        <Run Text="{Binding Hardware.SelectedInterface.Defaults.MaxTransfer, Mode=OneWay, TargetNullValue=n/a}"/>
                    </TextBlock>

                    <TextBlock Text="Documented facts" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Text, StringFormat=&#x2022; {0}}"/>
                                    <TextBlock Margin="12,0,0,0" FontSize="11">
                                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SourceUrl}"
                                                   Foreground="{DynamicResource InfoBrush}">
                                            <Run Text="{Binding SourceTitle, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Margin="12,0,0,0" FontSize="11" Text="{Binding SourceNote}" Foreground="{DynamicResource WarnBrush}" Visibility="{Binding SourceNote, Converter={StaticResource VisibleWhen}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Unverified - needs confirmation" FontWeight="SemiBold" Margin="0,8,0,4" Visibility="{Binding Hardware.SelectedInterface.Unverified, Converter={StaticResource VisibleWhen}}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.SelectedInterface.Unverified}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat=&#x2022; {0}}" Style="{StaticResource Subtle}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Compatibility modes" FontWeight="SemiBold" Margin="0,10,0,4" Visibility="{Binding Hardware.HasModes, Converter={StaticResource VisibleWhen}}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.Modes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Subtle}" FontSize="12">
                                        <Run Text="Max partition end:"/> <Run Text="{Binding MaxPartitionEndBytes, Mode=OneWay, Converter={StaticResource Bytes}, TargetNullValue=no limit}"/>
                                        <Run Text="  &#x2022;  Max FFS partition:"/> <Run Text="{Binding MaxFfsPartitionBytes, Mode=OneWay, Converter={StaticResource Bytes}, TargetNullValue=no limit}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat=&#x2022; {0}}" Style="{StaticResource Subtle}" FontSize="12"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Left" Content="Open profile folder" Command="{Binding OpenProfileFolderCommand}"/>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding ProfileFolder, StringFormat=Custom or corrected profiles (*.json) placed in {0} are loaded at start-up and replace built-in profiles with the same id.}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="RDB and partition inspector" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <RadioButton Content="Card" IsChecked="{Binding UseImageFile, Converter={StaticResource Not}}" Foreground="{DynamicResource TextBrush}"/>
                            <ComboBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedDevice}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <RadioButton Content="Image file" IsChecked="{Binding UseImageFile}" Foreground="{DynamicResource TextBrush}"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseImageCommand}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding ImagePath}" IsReadOnly="True"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                    <Button Content="Inspect (read-only)" Command="{Binding InspectCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding RawReport, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,10,0,0"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420"
                             Visibility="{Binding RawReport, Converter={StaticResource VisibleWhen}}" VerticalContentAlignment="Top"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
