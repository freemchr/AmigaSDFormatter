<UserControl x:Class="AmigaSdCreator.App.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,16"
                       Text="Full-card images with SHA-256 checksums. Backups are re-read and checked after writing; restores are verified by reading the card back."/>

            <Border Style="{StaticResource Callout}" Visibility="{Binding NeedsElevation, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding Main.RestartElevatedCommand}" Margin="8,0,0,0"/>
                    <TextBlock Text="Reading or writing cards requires administrator rights." VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Back up a card" Style="{StaticResource H2}"/>
                        <ListBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedSource}" ItemTemplate="{StaticResource DeviceTemplate}" Height="150"/>
                        <CheckBox Content="Compress (gzip) - smaller files, slower" IsChecked="{Binding Compress}" Margin="0,10,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Back up..." Style="{StaticResource PrimaryButton}" Command="{Binding BackupCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}"/>
                            <Button Content="Refresh" Command="{Binding Devices.RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,10,0,0" Text="Backing up only reads the card. It is safe for any card, including the ApolloOS CompactFlash card."/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Restore an image to a card" Style="{StaticResource H2}"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Choose image..." Command="{Binding ChooseRestoreImageCommand}" Margin="6,0,0,0" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}"/>
                            <TextBox Text="{Binding RestoreImagePath}" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="{Binding RestoreImageContents}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,8" Visibility="{Binding RestoreImageContents, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Text="Target card" Style="{StaticResource Subtle}"/>
                        <ListBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedTarget}" ItemTemplate="{StaticResource DeviceTemplate}" Height="110"/>
                        <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,10,0,10" Visibility="{Binding RestoreSummary, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding RestoreSummary}" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Type ERASE:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" Width="110" FontFamily="{StaticResource MonoFont}" Margin="0,0,10,0"/>
                            <Button Content="Restore" Style="{StaticResource DangerButton}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,10,0,0"
                                   Text="Only restore operating system images you are licensed to use (for example the ApolloOS image published by Apollo). The image is checked against its manifest before anything is written."/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="0"/>
                        <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,10,0,6"/>
                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Subtle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" BorderThickness="2" BorderBrush="{Binding LastSucceeded, Converter={StaticResource StatusBrush}}"
                    Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                <TextBlock>
                    <Run Text="{Binding LastSucceeded, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding LastSucceeded, Converter={StaticResource StatusBrush}}"/>
                    <Run Text="{Binding Message, Mode=OneWay}"/>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
