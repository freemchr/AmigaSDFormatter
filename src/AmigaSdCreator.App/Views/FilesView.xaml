<UserControl x:Class="AmigaSdCreator.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Amiga Files" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,14"
                       Text="Copy files between Windows and a card: FAT32 transfer cards, or the Amiga (OFS/FFS) partitions of hard-drive cards and disk images. Drag and drop between the panes, or drop files from Windows Explorer onto the right side."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Windows pane -->
            <Border Style="{StaticResource Card}" Margin="0" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Command="{Binding LoadDrivesCommand}" ToolTip="Refresh drives" Margin="4,0,0,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        </Button>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Name" Width="200"
                                  AutomationProperties.Name="Windows drive"/>
                        <TextBlock Text="Windows" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="&#x2191;" ToolTip="Up one folder" Command="{Binding WindowsUpCommand}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseWindowsFolderCommand}" Margin="6,0,0,0"/>
                        <TextBox x:Name="WindowsPathBox" Text="{Binding WindowsPath, Mode=OneWay}" KeyDown="OnWindowsPathKey" ToolTip="Type a path and press Enter"/>
                    </DockPanel>
                    <ListBox x:Name="WindowsList" ItemsSource="{Binding WindowsEntries}" SelectionMode="Extended" AllowDrop="True"
                             MouseDoubleClick="OnWindowsDoubleClick" PreviewMouseLeftButtonDown="OnDragStartCandidate" PreviewMouseMove="OnWindowsDragMove"
                             DragOver="OnWindowsDragOver" Drop="OnWindowsDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Subtle}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Transfer buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="Copy &#x2192;" Click="OnCopyRight" Margin="0,0,0,10" ToolTip="Copy the selected Windows files to the Amiga folder" IsEnabled="{Binding IsWritable}"/>
                <Button Content="&#x2190; Copy" Click="OnCopyLeft" Margin="0" ToolTip="Copy the selected Amiga files to the Windows folder" IsEnabled="{Binding IsOpen}"/>
                <CheckBox Content="Overwrite" IsChecked="{Binding Overwrite}" Margin="0,14,0,0" ToolTip="Replace files that already exist at the destination"/>
            </StackPanel>

            <!-- Amiga pane -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Amiga" Style="{StaticResource H2}"/>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <RadioButton Content="Card" IsChecked="{Binding SourceIsImage, Converter={StaticResource Not}}" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
                            <RadioButton Content="Image" IsChecked="{Binding SourceIsImage}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <ComboBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedDevice}"
                                      Visibility="{Binding SourceIsImage, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                            <DockPanel Visibility="{Binding SourceIsImage, Converter={StaticResource VisibleWhen}}">
                                <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseImageCommand}" Margin="6,0,0,0" Padding="10,4"/>
                                <TextBox Text="{Binding ImagePath}" IsReadOnly="True"/>
                            </DockPanel>
                        </Grid>
                        <Button Grid.Column="2" Content="Open" Command="{Binding OpenSourceCommand}" Margin="6,0,0,0"/>
                    </Grid>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right" Content="Allow changes" IsChecked="{Binding AllowChanges}" Margin="10,0,0,0"
                                  ToolTip="Open the partition for writing. Without this, it is opened read-only."/>
                        <ComboBox ItemsSource="{Binding PartitionChoices}" SelectedItem="{Binding SelectedPartition}" SelectionChanged="OnPartitionChanged"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="&#x2191;" Command="{Binding AmigaUpCommand}" Padding="10,4" Margin="0,0,6,0" IsEnabled="{Binding IsOpen}"/>
                        <TextBlock Text="{Binding AmigaLocation}" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VolumeInfo}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,6"/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsEnabled="{Binding IsWritable}">
                        <Button DockPanel.Dock="Right" Content="Delete" Click="OnDelete" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="New folder" Command="{Binding NewFolderCommand}" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name for a new folder (max 30 characters)"/>
                    </DockPanel>
                    <ListBox x:Name="AmigaList" ItemsSource="{Binding AmigaEntries}" SelectionMode="Extended" AllowDrop="True"
                             MouseDoubleClick="OnAmigaDoubleClick" PreviewMouseLeftButtonDown="OnDragStartCandidate" PreviewMouseMove="OnAmigaDragMove"
                             DragOver="OnAmigaDragOver" Drop="OnAmigaDrop" KeyDown="OnAmigaKey">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Comment}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icon" Text="&#x1F4C4;" FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource Subtle}" HorizontalAlignment="Right" TextWrapping="NoWrap" x:Name="Size"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ProtectionText}" Style="{StaticResource Mono}" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter TargetName="Icon" Property="Text" Value="&#x1F4C1;"/>
                                        <Setter TargetName="Size" Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <DockPanel Visibility="{Binding IsCopying, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCopyCommand}" Margin="10,0,0,0" Padding="12,3"/>
                    <StackPanel>
                        <ProgressBar Value="{Binding CopyPercent}" Maximum="100" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CopyProgress}" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120"
                                 Visibility="{Binding IsWorking, Converter={StaticResource VisibleWhen}}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Log}" MaxHeight="90" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                     Visibility="{Binding Log, Converter={StaticResource VisibleWhen}}"/>
        </Grid>
    </Grid>
</UserControl>
