<UserControl x:Class="AmigaSdCreator.App.Views.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <x:Array x:Key="DosTypeChoices" Type="sys:String">
            <sys:String>DOS\3</sys:String>
            <sys:String>DOS\1</sys:String>
            <sys:String>DOS\7</sys:String>
            <sys:String>PFS\3</sys:String>
            <sys:String>SFS\0</sys:String>
            <sys:String>SFS\2</sys:String>
        </x:Array>
    </UserControl.Resources>
    <Grid>
    <!-- ===================== Simple home screen ===================== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsWizard, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
        <StackPanel Margin="20,16,20,20" MaxWidth="820">

            <!-- Configure (steps 0-6) -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=Invert7}">
                <TextBlock Text="Select SD Card" Style="{StaticResource SectionLabel}"/>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Command="{Binding Devices.RefreshCommand}" ToolTip="Refresh" Margin="6,0,0,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                    </Button>
                    <Grid>
                        <ComboBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}"
                                  Style="{StaticResource LargeCombo}" AutomationProperties.Name="SD card"/>
                        <TextBlock Text="{Binding CardPlaceholder}" IsHitTestVisible="False" Margin="16,0,40,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}" FontSize="14"
                                   Visibility="{Binding SelectedDevice, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                    </Grid>
                </DockPanel>
                <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="2,0,0,4"
                           Visibility="{Binding Devices.Cards.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"
                           Text="Insert a card into a USB or SD card reader - the list updates automatically."/>
                <TextBlock FontSize="12" Margin="2,0,0,4" Foreground="{DynamicResource InfoBrush}" Text="{Binding Devices.NewCardMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedDevice}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding Devices.NewCardMessage, Converter={StaticResource VisibleWhen}}" Value="Visible"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel Margin="0,12,10,8">
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Models}" SelectedItem="{Binding HomeModel}" Width="230"
                              AutomationProperties.Name="Amiga model">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" Margin="10,0,0,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Choose Amiga Configuration" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding ModelNote}" Style="{StaticResource Subtle}" FontSize="12" Margin="2,0,10,8" Visibility="{Binding ModelNote, Converter={StaticResource VisibleWhen}}"/>
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChoiceTile}" GroupName="Preset" Margin="0,0,10,10" Tag="{Binding}"
                                         Checked="OnPresetChecked" Loaded="OnPresetLoaded">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="9" Padding="7,1"
                                            Background="{DynamicResource PanelAltBrush}" Visibility="{Binding ShowStatus, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Left" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Summary -->
                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,10,10">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Margin" Value="0,5"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Partition scheme"/>
                        <TextBlock Grid.Column="1" Text="{Binding SchemeText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Filesystem"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FilesystemText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="Partitions"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PartitionsText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="3" Text="Boot partition" Visibility="{Binding SelectedPreset.CanBoot, Converter={StaticResource VisibleWhen}}"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding BootEnabled}" HorizontalAlignment="Right"
                                  Visibility="{Binding SelectedPreset.CanBoot, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Grid.Row="4" Text="Kickstart" Visibility="{Binding Hardware.HasModes, Converter={StaticResource VisibleWhen}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Hardware.Modes}" SelectedItem="{Binding Hardware.SelectedMode}" DisplayMemberPath="Name"
                                  Width="330" HorizontalAlignment="Right" Margin="0,3" Visibility="{Binding Hardware.HasModes, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Grid.Row="5" Text="Unused space" Foreground="{DynamicResource WarnBrush}" Visibility="{Binding HasUnused, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UnusedText}" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Visibility="{Binding HasUnused, Converter={StaticResource VisibleWhen}}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Messages}" Margin="2,0,10,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Line" FontSize="12" Margin="0,1">
                                <Run Text="{Binding Severity, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding QuickHint}" Foreground="{DynamicResource WarnBrush}" Margin="2,0,10,8" Visibility="{Binding QuickHint, Converter={StaticResource VisibleWhen}}"/>

                <Button Style="{StaticResource BigButton}" Command="{Binding QuickPrepareCommand}" AutomationProperties.Name="Prepare SD Card" IsEnabled="{Binding CanQuickPrepare}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="Prepare SD Card" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,10,0">
                    <Button Style="{StaticResource LinkButton}" Content="Customise partitions..." Command="{Binding CustomiseCommand}"/>
                    <TextBlock Text="  &#x2022;  " Style="{StaticResource Subtle}"/>
                    <Button Style="{StaticResource LinkButton}" Content="Create an image file instead" Command="{Binding CreateImageCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Confirm (step 7) -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5"
                    Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=7}">
                <StackPanel>
                    <TextBlock Text="Erase and prepare this card?" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding TargetDescription}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,8" Visibility="{Binding Existing, Converter={StaticResource VisibleWhen}}">
                        <Run Text="Currently on the card:"/> <Run Text="{Binding Existing.Inspection.SchemeDescription, Mode=OneWay}"/>
                        <Run Text="with"/> <Run Text="{Binding Existing.Inspection.Partitions.Count, Mode=OneWay}"/> <Run Text="partition(s)."/>
                    </TextBlock>
                    <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource WarnBrush}" Visibility="{Binding Existing.Inspection.Partitions, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Back up first" Command="{Binding Main.NavigateCommand}" CommandParameter="Backup" Margin="8,0,0,0"/>
                            <TextBlock Text="Everything on this card will be permanently erased." VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding SafetyChecks}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" Margin="0,1">
                                    <Run Text="{Binding Passed, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Passed, Converter={StaticResource StatusBrush}}"/>
                                    <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding IsExperimental, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding AcceptExperimental}">
                            <TextBlock Text="I understand this configuration is experimental: it follows Amiga standards but these points are not yet confirmed:"/>
                        </CheckBox>
                        <ItemsControl ItemsSource="{Binding Hardware.SelectedInterface.Unverified}" Margin="24,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat=&#x2022; {0}}" Style="{StaticResource Subtle}" FontSize="12"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DockPanel>
                        <TextBlock Text="Type ERASE to confirm" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" Width="110" FontFamily="{StaticResource MonoFont}"/>
                        <Button DockPanel.Dock="Right" Content="Erase and prepare" Style="{StaticResource DangerButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" Margin="0"/>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelConfirmCommand}"/>
                        <Border/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Working (step 8) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=8}">
                <StackPanel>
                    <TextBlock Text="Preparing - do not remove the card" Style="{StaticResource H2}"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ProgressLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Result (step 9) -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=9}">
                <Border Style="{StaticResource Card}" BorderThickness="1.5" BorderBrush="{Binding Succeeded, Converter={StaticResource StatusBrush}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Succeeded, Converter={StaticResource Glyph}}" FontSize="22" Margin="0,0,12,0"
                                   Foreground="{Binding Succeeded, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ResultText}" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Callout}" Visibility="{Binding NextStepsText, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="Next steps" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NextStepsText}"/>
                    </StackPanel>
                </Border>
                <Expander Header="Verification details" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" Visibility="{Binding Checks, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="22,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" Margin="0,1">
                                    <Run Text="{Binding Passed, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Passed, Converter={StaticResource StatusBrush}}"/>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Command="{Binding DoneCommand}" HorizontalAlignment="Left" Padding="24,7"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- ===================== Full wizard ===================== -->
    <Grid Margin="20,14" Visibility="{Binding IsWizard, Converter={StaticResource VisibleWhen}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and step indicator -->
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Back to simple view" Command="{Binding BackToHomeCommand}" VerticalAlignment="Center"/>
                <TextBlock Text="Prepare SD Card - custom setup" Style="{StaticResource H1}"/>
            </DockPanel>
            <ProgressBar Value="{Binding Step, Mode=OneWay}" Maximum="9" Height="4" Margin="0,8,0,4"/>
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,18" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Style="{StaticResource Subtle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="980" HorizontalAlignment="Left">

                <!-- 0: Target -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=0}">
                    <TextBlock Text="What do you want to prepare?" Style="{StaticResource H2}"/>
                    <RadioButton Style="{StaticResource ChoiceTile}" IsChecked="{Binding TargetIsImage, Converter={StaticResource Not}}">
                        <StackPanel>
                            <TextBlock Text="An SD card connected to this PC" FontWeight="SemiBold"/>
                            <TextBlock Text="The card will be erased. Protected and system disks cannot be selected." Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource Card}" Margin="20,0,0,10" Visibility="{Binding TargetIsImage, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Devices.Cards}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}" MinHeight="90" MaxHeight="220"/>
                            <DockPanel Margin="0,8,0,0">
                                <Button Content="Refresh" Command="{Binding Devices.RefreshCommand}" Padding="10,3"/>
                                <TextBlock Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"
                                           Text="No card listed? Insert it, wait a moment and press Refresh. Cards in internal readers may need 'Allow internal disks' in Settings."/>
                            </DockPanel>
                            <Border Style="{StaticResource Callout}" Margin="0,10,0,0" Visibility="{Binding NeedsElevation, Converter={StaticResource VisibleWhen}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding Main.RestartElevatedCommand}" Margin="8,0,0,0"/>
                                    <TextBlock Text="Writing to a card needs administrator rights. Your choices so far are not kept when restarting." VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" Text="{Binding SelectedDevice.ProtectionReason, StringFormat=This disk is protected: {0}}"
                                       Visibility="{Binding SelectedDevice.ProtectionReason, Converter={StaticResource VisibleWhen}}"/>
                        </StackPanel>
                    </Border>
                    <RadioButton Style="{StaticResource ChoiceTile}" IsChecked="{Binding TargetIsImage}">
                        <StackPanel>
                            <TextBlock Text="A disk image file (.img / .hdf)" FontWeight="SemiBold"/>
                            <TextBlock Text="Build and verify the layout safely as a file. Write it to a card later, or use it in WinUAE." Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource Card}" Margin="20,0,0,10" Visibility="{Binding TargetIsImage, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save as..." Command="{Binding BrowseImageCommand}" Margin="6,0,12,0"/>
                                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <TextBlock Grid.Column="1" Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Subtle}"/>
                            <TextBox Grid.Column="2" Text="{Binding ImageSizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example 8 GB or 512 MB. Use the exact size of the card you will write it to (or smaller)."/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 1: Model -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=1}">
                    <TextBlock Text="Which Amiga will use this card?" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="Model"
                                             IsEnabled="{Binding Interfaces, Converter={StaticResource HasItems}}"
                                             Checked="OnModelChecked" Loaded="OnModelLoaded" Tag="{Binding}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Subtle}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Text="Models marked Planned are not supported yet. Selected model:"/>
                    <TextBlock Text="{Binding Hardware.SelectedProfile.Name}" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 2: Connection -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=2}">
                    <TextBlock Text="How will the card be connected?" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.Interfaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="Iface" Checked="OnInterfaceChecked" Tag="{Binding}" Loaded="OnInterfaceLoaded">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <ItemsControl ItemsSource="{Binding Facts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Text, StringFormat=• {0}}" Style="{StaticResource Subtle}" FontSize="12"/></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Callout}" Visibility="{Binding Hardware.SelectedInterface.Unverified, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Not yet verified for this connection" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Hardware.SelectedInterface.Unverified}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Subtle}"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3: Use -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=3}">
                    <TextBlock Text="What will the card be used for?" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Hardware.Uses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="Use" Checked="OnUseChecked" Tag="{Binding}" Loaded="OnUseLoaded">
                                    <TextBlock Text="{Binding Converter={StaticResource UseText}}" FontWeight="SemiBold" FontSize="14"/>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Callout}" Visibility="{Binding IsProtectedInterface, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Go to Restore" Command="{Binding GoToRestoreCommand}" Margin="8,0,0,0"/>
                            <TextBlock Text="This is the ApolloOS system drive. It is never repartitioned here: back it up, or restore an authorised ApolloOS image from Apollo, in Backup &amp; Restore." VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 4: Inspect -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=4}">
                    <TextBlock Text="Current contents" Style="{StaticResource H2}"/>
                    <TextBlock Text="Reading the card..." Visibility="{Binding IsInspecting, Converter={StaticResource VisibleWhen}}"/>
                    <TextBlock Text="A new image file will be created; there is nothing to inspect." Visibility="{Binding TargetIsImage, Converter={StaticResource VisibleWhen}}"/>
                    <TextBlock Text="{Binding InspectError}" Foreground="{DynamicResource WarnBrush}" Visibility="{Binding InspectError, Converter={StaticResource VisibleWhen}}"/>
                    <StackPanel Visibility="{Binding Existing, Converter={StaticResource VisibleWhen}}">
                        <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource WarnBrush}"
                                Visibility="{Binding Existing.Inspection.Partitions, Converter={StaticResource VisibleWhen}}">
                            <TextBlock FontWeight="SemiBold" Text="This card contains partitions and possibly data. Everything on it will be erased. If you need anything from it, cancel and make a backup first (Backup &amp; Restore)."/>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Layout:" Foreground="{DynamicResource SubtleTextBrush}"/> <Run Text="{Binding Existing.Inspection.SchemeDescription, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="  •  Assessment for the selected slot:" Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <Run Text="{Binding Existing.Verdict, Mode=OneWay, Converter={StaticResource VerdictText}}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Existing.Summary}" Style="{StaticResource Subtle}" Margin="0,4,0,8"/>
                                <ItemsControl ItemsSource="{Binding Existing.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2">
                                                <Run Text="{Binding Severity, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Callout}" Visibility="{Binding Existing.Recommendations, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="Diagnosis recommends" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Existing.Recommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Text, StringFormat=• {0}}" Style="{StaticResource Subtle}"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 5: Configure -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=5}">
                    <TextBlock Text="Recommended configuration" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12" Text="These settings come from the hardware profile. Change them only if you know you need to (Advanced)."/>

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsFatPlan, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Volume label"/>
                                <TextBox Text="{Binding FatLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" CharacterCasing="Upper"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Cluster size (bytes)"/>
                                <ComboBox ItemsSource="{Binding ClusterChoices}" SelectedItem="{Binding FatClusterBytes}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Margin="20,18,0,0" Style="{StaticResource Subtle}"
                                       Text="MBR partition table, one FAT32 partition starting at 1 MiB, created by this app's own formatter (not the Windows format command)."/>
                        </Grid>
                    </Border>

                    <StackPanel Visibility="{Binding IsRdbPlan, Converter={StaticResource VisibleWhen}}">
                        <Border Style="{StaticResource Card}" Visibility="{Binding Hardware.HasModes, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <Label Content="Kickstart / compatibility"/>
                                <ComboBox ItemsSource="{Binding Hardware.Modes}" SelectedItem="{Binding Hardware.SelectedMode}" DisplayMemberPath="Name" Width="460" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{Binding Hardware.SelectedMode.Notes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Subtle}" FontSize="12"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Add partition" Command="{Binding AddPartitionCommand}" Margin="0"/>
                                    <TextBlock Text="Partitions" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Partitions}" CanUserSortColumns="False" RowHeight="30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                        <DataGridTextColumn Header="Volume name" Binding="{Binding VolumeName, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                        <DataGridTextColumn Header="Size (MiB or 'rest')" Binding="{Binding SizeMiB, UpdateSourceTrigger=LostFocus}" Width="130"/>
                                        <DataGridTextColumn Header="Actual" Binding="{Binding ActualSize}" IsReadOnly="True" Width="90"/>
                                        <DataGridComboBoxColumn Header="Filesystem" SelectedItemBinding="{Binding DosTypeText}" Width="90"
                                                                ItemsSource="{StaticResource DosTypeChoices}"/>
                                        <DataGridCheckBoxColumn Header="Boot" Binding="{Binding Bootable, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                        <DataGridTextColumn Header="Pri" Binding="{Binding BootPriority, UpdateSourceTrigger=LostFocus}" Width="50"/>
                                        <DataGridCheckBoxColumn Header="Format now" Binding="{Binding FormatNow, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                        <DataGridTextColumn Header="MaxTransfer" Binding="{Binding MaxTransferText, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                        <DataGridTextColumn Header="Cylinders" Binding="{Binding Cylinders}" IsReadOnly="True" Width="90"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Padding="6,0" Margin="0" ToolTip="Remove partition"
                                                            Command="{Binding DataContext.RemovePartitionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,8,0,0">
                                    <Run Text="Unallocated:"/> <Run Text="{Binding UnallocatedText, Mode=OneWay}"/>
                                    <Run Text="  •  'Format now' creates an empty FFS volume (OFS/FFS only). Other filesystems are formatted on the Amiga."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Add handler file..." Command="{Binding AddHandlerCommand}" Margin="0"/>
                                    <TextBlock Text="Filesystem handlers stored in the RDB" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap"
                                           Text="Needed for PFS3 or SFS partitions when the handler is not in ROM. Supply your own copy (e.g. pfs3aio from Aminet); none is bundled."/>
                                <ItemsControl ItemsSource="{Binding Handlers}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2" Margin="0"
                                                        Command="{Binding DataContext.RemoveHandlerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="{Binding DosType.FriendlyName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding SourceName, Mode=OneWay}"/> <Run Text="{Binding VersionText, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2">
                                    <Run Text="{Binding Severity, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                    <Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 6: Preview -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=6}">
                    <TextBlock Text="Preview" Style="{StaticResource H2}"/>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding PreviewLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2">
                                    <Run Text="{Binding Severity, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                    <Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 7: Confirm -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=7}">
                    <TextBlock Text="Confirm" Style="{StaticResource H2}"/>
                    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="Target" Style="{StaticResource Subtle}"/>
                            <TextBlock Text="{Binding TargetDescription}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,10"/>
                            <ItemsControl ItemsSource="{Binding SafetyChecks}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,1">
                                            <Run Text="{Binding Passed, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Passed, Converter={StaticResource StatusBrush}}"/>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox IsChecked="{Binding UnderstandErase}">
                                <TextBlock Text="I understand that everything currently on this target will be permanently erased."/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AcceptExperimental}" Visibility="{Binding IsExperimental, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="I understand this connection is experimental: the layout follows Amiga standards but has not been confirmed on this hardware."/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding TargetIsImage, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                                <TextBlock Text="Type ERASE to confirm:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" Width="140" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,10,0,0"
                                       Text="The card's identity (path, model, serial number and size) is checked again immediately before writing. If it has changed or been removed, nothing is written."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 8: Working -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=8}">
                    <TextBlock Text="Preparing..." Style="{StaticResource H2}"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"/>
                    <TextBlock Text="Do not remove the card." FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ProgressLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 9: Result -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=9}">
                    <Border Style="{StaticResource Card}" BorderThickness="2" BorderBrush="{Binding Succeeded, Converter={StaticResource StatusBrush}}">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{Binding Succeeded, Converter={StaticResource StatusBrush}}"
                                       Text="{Binding Succeeded, Converter={StaticResource Glyph}}"/>
                            <TextBlock Text="{Binding ResultText}" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Checks, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Verification" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,1">
                                            <Run Text="{Binding Passed, Mode=OneWay, Converter={StaticResource Glyph}}" Foreground="{Binding Passed, Converter={StaticResource StatusBrush}}"/>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Callout}" Visibility="{Binding NextStepsText, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Next steps" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NextStepsText}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Prepare another card" Command="{Binding ResetCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Navigation -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Start over" Command="{Binding ResetCommand}" IsEnabled="{Binding CanGoBack}"/>
            <Button DockPanel.Dock="Right" Content="Next" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" Padding="26,8" Margin="0"
                    Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=Invert7}"/>
            <Button DockPanel.Dock="Right" Content="Erase and prepare" Style="{StaticResource DangerButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" Padding="26,8" Margin="0"
                    Visibility="{Binding Step, Converter={StaticResource StepVisible}, ConverterParameter=7}"/>
            <Button DockPanel.Dock="Right" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
    </Grid>
</UserControl>
