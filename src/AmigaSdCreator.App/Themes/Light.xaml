<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: Workbench 1.3 blue sidebar, warm grey panels, orange accents. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0055AA"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CDD4DE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#16202C"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#5A6778"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E67700"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#0055AA"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E3E9F1"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#CFE0F5"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1E8A55"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#1D64B8"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#A86A00"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B23"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#0B64C0"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1B76D1"/>
    <BitmapImage x:Key="LogoImage" UriSource="pack://application:,,,/Assets/logo.png"/>
</ResourceDictionary>
